# configure.upp
#
# This file was automatically generated by the configure script in the
# top level directory. You may make changes to the settings in this
# file but be aware they will be overwritten each time you run configure.
# Ordinarily, it is necessary to run configure once, when the code is
# first installed.
#
# To permanently change options, change the settings for your platform
# in the file arch/configure.defaults then rerun configure.
#

SHELL           	=       /bin/sh

LDFLAGS_MPI             =     # to be overridden later

#### Architecture specific settings ####

PROC_OPTS       =       -axCORE-AVX512,CORE-AVX2,AVX,SSE4.2 -static-intel

# Settings for Linux x86_64, Intel compiler	 (dmpar)#
SFC     = ifort $(PROC_OPTS)
SF90    = ifort -free $(PROC_OPTS)
SCC     = icc $(PROC_OPTS)

DM_FC  = mpiifort 
DM_F90 = mpiifort -free 
DM_CC  = mpiicc 

FC      = $(DM_FC)
F90     = $(DM_F90)
CC      = $(DM_CC)
CPP     = /lib/cpp

LINUX_OBJ     =
BYTE_ORDER    = UPPLITTLEENDIAN
SIZE_I8R8   = -r8 -i8
SIZE_I4R8   = -r8 -i4
SIZE_I4R4   = -r4 -i4
SIZE        =

PPDEFINE   = -DCOMMCODE -DLINUX -D$(BYTE_ORDER)
FPPDEFINE  = $(PPDEFINE)

FDEBUG  = -O0 -g -traceback -check all -ftrapuv -fpe0
CRTMDBUG= -O0 -g -traceback -check all -ftrapuv -fpe0
CDEBUG  = -O0 -g -traceback -debug all -Wall -check-uninit

FOPT    = -O3
CRTMOPT = -O3
COPT    = -O3

CPP_FLAGS = -P -traditional-cpp $(FPPDEFINE)
INC_FLAGS =
LDFLAGS   = -Wl,-noinhibit-exec 
FFLAGS    = -fp-model source -ip -ftz -assume byterecl -convert big_endian \
            -heap-arrays $(SIZE) $(FPPDEFINE) $(FOPT)
CFLAGS    = $(PPDEFINE) $(COPT)
ARFLAGS   = ru

FFLAGS_CRTM  = -c -fp-model source -ftz  -assume byterecl -convert big_endian \
               $(SIZE) $(FOPT)
#FFLAGS_CRTM = -c -checkbound -convert big_endian -e03 -free -assume byterecl -fp-stack-check -mieee-fp
FL_CRTM     = 

###########################################################
#
#	Macros, these should be generic for all machines
LN		=   ln -sf
MAKE  =   make
RM		=   /bin/rm -f
CP		=   /bin/cp
MV              =   /bin/mv
AR		=   ar
RANLIB		=   ranlib

NCEPLIBLIB      =    -L/usr/local/nceplibs/intel/lib
NCEPLIBINC      =    -I/usr/local/nceplibs/intel/include
NCEPLIB_FLAGS   =    -lwrfio -lg2_v3.1.0_4 -lg2tmpl_v1.5.0 -lnemsio_d -lsigio_v2.0.1_4 -lsfcio_v1.0.0_4 -lgfsio_4 -lsp_v2.0.2_d -lw3nco_v2.0.6_4 -lw3emc_v2.2.0_4 -lbacio_4 -ljasper -lpng -lcurl -lm -lz

NETCDFPATH      =    /usr/local/netcdf/intel
NETCDFLIBS      =    -lnetcdff -lnetcdf

COMMS_ADD_OBJ   =    
COMMS_ADD_OBJST =    
COMMS_LIB       =    

SERIAL_MPI_STUB =    
SERIAL_MPI_LIB  =    

PARALLEL_FLAG   =    -DDM_PARALLEL

GRIB2SUPT_LIB   =    
GRIB2SUPT_INC   =    

BINDIR          =    /home/oper/arw/model/src/post/UPPV4.1/exec
INCMOD          =    /home/oper/arw/model/src/post/UPPV4.1/include
LIBDIR          =    /home/oper/arw/model/src/post/UPPV4.1/lib

#
# These files may be changed to enable other files with the same 
# functions definitions, but different logic.  This is typically
# how backward compatibilty is achieved for the community code.
GRIBIT = GRIBIT.f
CALRAD = CALRAD_WCLOUD_crtm.f

# There is probably no reason to modify these rules
.SUFFIXES : .c .f .f90
.c.o:
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS)  $<

.f.o:
	$(FC) $(FFLAGS) $(EXTRA_FFLAGS) $<

.f90.o :
	$(F90) $(FFLAGS) $(EXTRA_FFLAGS) $<

.F.o:
	$(CPP) $(CPP_FLAGS) $< > $*.f
	$(FC) $(FFLAGS) $(EXTRA_FFLAGS) $<

.F90.o:
	$(CPP) $(CPP_FLAGS) $< > $*.f90
	$(F90) $(FFLAGS) $(EXTRA_FFLAGS) $<
